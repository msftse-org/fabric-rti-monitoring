# Optional build-time browser telemetry. Leave blank for no telemetry.
# Vite embeds this value in the public browser bundle: do not put secrets here.
# Only fixed page routes and navigation/FCP timing numbers are sent. Calculator
# inputs, imported files, query strings, referrers, dependencies and automatic
# exceptions are excluded. Azure receives the network IP and user agent.
# Diagnostic export must include AppPageViews and AppEvents for this demo.
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=
