{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "../../../",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "composite": true,
    "declaration": true
  },
  "include": [
    "src/**/*",
    "../../../oncall/src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
