// Run management commands against the Observability database, not a query tab
// connected to another database. Bootstrap applies these through Kusto management.
// Column contract: OpenTelemetry Collector Contrib azuredataexplorer exporter
// v0.141.0 (Apache-2.0). See THIRD_PARTY_NOTICES.md and upstream README:
// https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/v0.141.0/exporter/azuredataexplorerexporter

.create-merge table OTELLogs (Timestamp:datetime, ObservedTimestamp:datetime, TraceID:string, SpanID:string, SeverityText:string, SeverityNumber:int, Body:string, ResourceAttributes:dynamic, LogsAttributes:dynamic)

.create-merge table OTELMetrics (Timestamp:datetime, MetricName:string, MetricType:string, MetricUnit:string, MetricDescription:string, MetricValue:real, Host:string, ResourceAttributes:dynamic, MetricAttributes:dynamic)

.create-merge table OTELTraces (TraceID:string, SpanID:string, ParentID:string, SpanName:string, SpanStatus:string, SpanKind:string, StartTime:datetime, EndTime:datetime, ResourceAttributes:dynamic, TraceAttributes:dynamic, Events:dynamic, Links:dynamic, SpanStatusMessage:string)

// Managed streaming is appropriate for this small, low-latency demo.
.alter table OTELLogs policy streamingingestion enable

.alter table OTELMetrics policy streamingingestion enable

.alter table OTELTraces policy streamingingestion enable

// Keep the demo bounded. Choose retention and hot-cache policies per workload.
.alter-merge table OTELLogs policy retention softdelete = 7d

.alter-merge table OTELMetrics policy retention softdelete = 7d

.alter-merge table OTELTraces policy retention softdelete = 7d

.alter table OTELLogs policy caching hot = 1d

.alter table OTELMetrics policy caching hot = 1d

.alter table OTELTraces policy caching hot = 1d

.alter table OTELLogs policy ingestiontime true

.alter table OTELMetrics policy ingestiontime true

.alter table OTELTraces policy ingestiontime true

// Materialized views aggregate as data arrives. Querying the view name includes
// the unmaterialized delta, unlike materialized_view(), which can be stale.
// Create these before running the demo: backfill=false skips existing rows.
.create-or-alter materialized-view Logs1m on table OTELLogs {
    OTELLogs
    | where ResourceAttributes["demo.synthetic"] == true
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"])
    | summarize LogCount=count(), ErrorCount=countif(SeverityNumber >= 17) by WindowStart=bin(Timestamp, 1m), Service, Environment
}

.create-or-alter materialized-view Requests1m on table OTELTraces {
    OTELTraces
    | where ResourceAttributes["demo.synthetic"] == true and SpanName == "demo.request"
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), DurationMs=(EndTime-StartTime)/1ms
    | summarize RequestCount=count(), ErrorCount=countif(SpanStatus == "STATUS_CODE_ERROR"), DurationSumMs=sum(DurationMs), DurationDigest=tdigest(DurationMs) by WindowStart=bin(StartTime, 1m), Service, Environment
}

.create-or-alter materialized-view Metrics1m on table OTELMetrics {
    OTELMetrics
    | where ResourceAttributes["demo.synthetic"] == true
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"])
    | summarize SampleCount=count(), ValueSum=sum(MetricValue), ValueMin=min(MetricValue), ValueMax=max(MetricValue) by WindowStart=bin(Timestamp, 1m), Service, Environment, MetricName, MetricType, MetricUnit
}

// Eventhouse applies its default retention to materialized views.
.alter materialized-view Logs1m policy caching hot = 1d

.alter materialized-view Requests1m policy caching hot = 1d

.alter materialized-view Metrics1m policy caching hot = 1d

.create-or-alter function with (folder='Observability', docstring='One-minute log counts from the Logs1m materialized view') LogsOverview(lookback:timespan=24h) {
    Logs1m
    | where WindowStart > ago(lookback)
    | project WindowStart, Service, Environment, LogCount, ErrorCount
}

.create-or-alter function with (folder='Observability', docstring='Root request latency and errors from Requests1m; percentiles are approximate') RequestsOverview(lookback:timespan=24h) {
    Requests1m
    | where WindowStart > ago(lookback)
    | extend Percentiles=percentiles_array_tdigest(DurationDigest, dynamic([50,95]))
    | project WindowStart, Service, Environment, RequestCount, ErrorCount, AverageMs=DurationSumMs/RequestCount, P50Ms=todouble(Percentiles[0]), P95Ms=todouble(Percentiles[1])
}

.create-or-alter function with (folder='Observability', docstring='Duration gauge sample statistics from Metrics1m; not a request rate') MetricDurationOverview(lookback:timespan=24h) {
    Metrics1m
    | where WindowStart > ago(lookback) and MetricName == 'demo.request.duration' and MetricType == 'Gauge'
    | project WindowStart, Service, Environment, SampleCount, AverageMs=ValueSum/SampleCount, MinimumMs=ValueMin, MaximumMs=ValueMax
}

// ---------------------------------------------------------------------------
// Issues: group failed spans into a small number of issues by fingerprint.
// The collector keeps only cleaned `exception` span events (type and message).
// The fingerprint is service + span name + exception type + normalized message,
// so the same failure with different IDs, numbers, or addresses lands in one
// issue, and an issue keeps its identity across environments and versions.
// ---------------------------------------------------------------------------

.create-or-alter function with (folder='Issues', docstring='Replaces variable values in an error message with placeholders so equal failures group together') NormalizeErrorMessage(message:string) {
    let uuids = replace_regex(message, @'[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}', '<uuid>');
    let emails = replace_regex(uuids, @'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}', '<email>');
    let addresses = replace_regex(emails, @'[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}', '<ip>');
    let hex = replace_regex(addresses, @'(0x)?[0-9a-fA-F]{16,}', '<hex>');
    let numbers = replace_regex(hex, @'[0-9]+', '<n>');
    substring(trim(@'\s+', replace_regex(numbers, @'\s+', ' ')), 0, 256)
}

.create-or-alter function with (folder='Issues', docstring='One row per failed synthetic span with its exception and issue fingerprint') ErrorEvents(lookback:timespan=1h) {
    OTELTraces
    | where StartTime > ago(lookback)
    | where ResourceAttributes["demo.synthetic"] == true and SpanStatus == "STATUS_CODE_ERROR"
    | mv-apply Event=Events to typeof(dynamic) on (
        summarize ExceptionType=take_anyif(tostring(Event.EventAttributes["exception.type"]), tostring(Event.EventName) == "exception"),
            RawMessage=take_anyif(tostring(Event.EventAttributes["exception.message"]), tostring(Event.EventName) == "exception")
    )
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), Version=tostring(ResourceAttributes["service.version"])
    | extend ExceptionType=iff(isempty(ExceptionType), "SpanError", ExceptionType)
    | extend Message=iff(isempty(RawMessage), strcat(SpanName, " failed"), NormalizeErrorMessage(RawMessage))
    | extend Fingerprint=substring(hash_sha256(strcat(Service, "|", SpanName, "|", ExceptionType, "|", Message)), 0, 16)
    | project Timestamp=StartTime, Fingerprint, Service, Environment, Version, SpanName, ExceptionType, Message, TraceID, SpanID, RunID=tostring(TraceAttributes["demo.run_id"])
}

// Hourly issue counts. The fingerprint is a bounded dimension (one per distinct
// failure, not per request); trace and span IDs are only sampled as an example.
.create-or-alter materialized-view Issues1h on table OTELTraces {
    OTELTraces
    | where ResourceAttributes["demo.synthetic"] == true and SpanStatus == "STATUS_CODE_ERROR"
    | mv-apply Event=Events to typeof(dynamic) on (
        summarize ExceptionType=take_anyif(tostring(Event.EventAttributes["exception.type"]), tostring(Event.EventName) == "exception"),
            RawMessage=take_anyif(tostring(Event.EventAttributes["exception.message"]), tostring(Event.EventName) == "exception")
    )
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), Version=tostring(ResourceAttributes["service.version"])
    | extend ExceptionType=iff(isempty(ExceptionType), "SpanError", ExceptionType)
    | extend Message=iff(isempty(RawMessage), strcat(SpanName, " failed"), NormalizeErrorMessage(RawMessage))
    | extend Fingerprint=substring(hash_sha256(strcat(Service, "|", SpanName, "|", ExceptionType, "|", Message)), 0, 16)
    | summarize EventCount=count(), FirstSeen=min(StartTime), LastSeen=max(StartTime), ExampleTraceID=take_any(TraceID) by WindowStart=bin(StartTime, 1h), Fingerprint, Service, Environment, Version, SpanName, ExceptionType, Message
}

.alter materialized-view Issues1h policy caching hot = 1d

// Append-only triage state: the newest row per fingerprint wins. Written by
// scripts/issue-state.py through Kusto management as the signed-in user.
.create-merge table IssueState (Fingerprint:string, Status:string, ResolvedInVersion:string, MutedUntil:datetime, ChangedBy:string, ChangedAt:datetime, Note:string)

.alter-merge table IssueState policy retention softdelete = 365d

.create-or-alter function with (folder='Issues', docstring='Current triage state per issue fingerprint: open, resolved, or muted') IssueStatus() {
    IssueState
    | summarize arg_max(ChangedAt, *) by Fingerprint
    | extend Muted=Status == "muted" and (isnull(MutedUntil) or MutedUntil > now())
    | extend EffectiveStatus=case(Status == "muted" and not(Muted), "open", Status)
}

.create-or-alter function with (folder='Issues', docstring='Issues seen in the lookback window with first/last seen, counts, versions, status, and a 24-hour hourly trend') Issues(lookback:timespan=24h) {
    let recent = Issues1h
        | where WindowStart > ago(lookback + 1h) and LastSeen > ago(lookback);
    let firstSeen = Issues1h
        | summarize arg_min(FirstSeen, Version) by Fingerprint
        | project Fingerprint, EverFirstSeen=FirstSeen, IntroducedIn=Version;
    let trend = Issues1h
        | where WindowStart > ago(24h)
        | make-series Trend=sum(EventCount) default=0 on WindowStart from bin(ago(23h), 1h) to now() step 1h by Fingerprint, Environment
        | project Fingerprint, Environment, Trend;
    recent
    | summarize Events=sum(EventCount), FirstSeenInWindow=min(FirstSeen), LastSeen=max(LastSeen), Versions=make_set(Version), ExampleTraceID=take_any(ExampleTraceID) by Fingerprint, Service, Environment, SpanName, ExceptionType, Message
    | join kind=leftouter firstSeen on Fingerprint
    | join kind=leftouter trend on Fingerprint, Environment
    | join kind=leftouter (IssueStatus() | project Fingerprint, EffectiveStatus, ResolvedInVersion, MutedUntil, ChangedBy, ChangedAt) on Fingerprint
    | extend Status=coalesce(EffectiveStatus, "open"), Title=strcat(ExceptionType, ": ", Message), Culprit=strcat(Service, " / ", SpanName)
    | project Fingerprint, Title, Culprit, Service, Environment, SpanName, ExceptionType, Message, Status, Events, FirstSeen=EverFirstSeen, LastSeen, IntroducedIn, Versions, ExampleTraceID, Trend, ResolvedInVersion, MutedUntil, StatusChangedBy=ChangedBy, StatusChangedAt=ChangedAt
    | order by LastSeen desc
}

// Alert triggers in the style of an error tracker, evaluated over a short window
// for Activator or the RTI On-Call app. Each fires once per transition:
//   new_issue   the fingerprint was first seen inside the window
//   regression  the first event after the issue was resolved fell inside the
//               window (when it was resolved in a version, only events from that
//               version or later count). Searches the 7-day raw retention.
//   unmute      a mute expired inside the window and the issue occurred after it
// Muted issues raise nothing until the mute expires.
.create-or-alter function with (folder='Issues', docstring='new_issue, regression, and unmute alerts for issues active in the lookback window') IssueAlerts(lookback:timespan=15m) {
    let state = IssueStatus()
        | project Fingerprint, Status, ResolvedInVersion, MutedUntil, Muted, ChangedAt;
    let regressions = ErrorEvents(7d)
        | join kind=inner (state | where Status == "resolved") on Fingerprint
        | where Timestamp > ChangedAt
        | where isempty(ResolvedInVersion) or isnull(parse_version(Version)) or parse_version(Version) >= parse_version(ResolvedInVersion)
        | summarize RegressedAt=min(Timestamp) by Fingerprint;
    let everFirst = Issues1h
        | summarize EverFirstSeen=min(FirstSeen) by Fingerprint;
    ErrorEvents(lookback)
    | join kind=leftouter state on Fingerprint
    | extend Status=coalesce(Status, "open"), Muted=coalesce(Muted, false)
    | summarize Events=count(), FirstEvent=min(Timestamp), LastEvent=max(Timestamp), EventsAfterMute=countif(Status == "muted" and Timestamp > MutedUntil), Versions=make_set(Version), ExampleTraceID=take_any(TraceID), Muted=take_any(Muted), MutedUntil=take_any(MutedUntil), Status=take_any(Status)
        by Fingerprint, Service, Environment, SpanName, ExceptionType, Message
    | join kind=leftouter everFirst on Fingerprint
    | join kind=leftouter regressions on Fingerprint
    | extend EverFirstSeen=coalesce(EverFirstSeen, FirstEvent)
    | extend AlertType=case(
        Muted, "",
        Status == "resolved" and RegressedAt > ago(lookback), "regression",
        Status == "muted" and MutedUntil > ago(lookback) and EventsAfterMute > 0, "unmute",
        Status == "open" and EverFirstSeen > ago(lookback), "new_issue",
        "")
    | where isnotempty(AlertType)
    | project AlertType, Fingerprint, Title=strcat(ExceptionType, ": ", Message), Service, Environment, SpanName, Events, FirstEvent, LastEvent, Versions, ExampleTraceID
    | order by LastEvent desc
}

// ---------------------------------------------------------------------------
// Release health: is this deploy worse than the last one? One-minute server-span
// counts per service, environment, and service.version (a bounded dimension).
// Tiers (parameters): healthy >= 99% error-free, degraded >= 95%, unhealthy below,
// and "too few requests" under 50 requests, where a rate is noise.
// ---------------------------------------------------------------------------

.create-or-alter materialized-view Releases1m on table OTELTraces {
    OTELTraces
    | where ResourceAttributes["demo.synthetic"] == true and SpanKind == "SPAN_KIND_SERVER"
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), Version=tostring(ResourceAttributes["service.version"]), DurationMs=(EndTime-StartTime)/1ms
    | summarize RequestCount=count(), ErrorCount=countif(SpanStatus == "STATUS_CODE_ERROR"), DurationDigest=tdigest(DurationMs), FirstSeen=min(StartTime), LastSeen=max(StartTime) by WindowStart=bin(StartTime, 1m), Service, Environment, Version
}

.alter materialized-view Releases1m policy caching hot = 1d

.create-or-alter function with (folder='Releases', docstring='Requests, error-free rate, p95, new issues, and a health tier per service release') ReleaseHealth(lookback:timespan=24h, healthy:real=0.99, degraded:real=0.95, minRequests:long=50) {
    let introduced = Issues1h
        | summarize arg_min(FirstSeen, Version) by Fingerprint, Service, Environment
        | summarize NewIssues=count() by Service, Environment, Version;
    Releases1m
    | where WindowStart > ago(lookback)
    | summarize Requests=sum(RequestCount), Errors=sum(ErrorCount), Digest=tdigest_merge(DurationDigest), FirstSeen=min(FirstSeen), LastSeen=max(LastSeen) by Service, Environment, Version
    | extend ErrorFreeRate=round(1.0 - todouble(Errors) / Requests, 4), P95Ms=round(todouble(percentiles_array_tdigest(Digest, dynamic([95]))[0]), 1)
    | join kind=leftouter introduced on Service, Environment, Version
    | extend NewIssues=coalesce(NewIssues, 0)
    | extend Tier=case(Requests < minRequests, "too few requests", ErrorFreeRate >= healthy, "healthy", ErrorFreeRate >= degraded, "degraded", "unhealthy")
    | project Service, Environment, Version, Tier, ErrorFreeRate, Requests, Errors, P95Ms, NewIssues, FirstSeen, LastSeen
    | order by Service asc, Environment asc, LastSeen desc
}

.create-or-alter function with (folder='Releases', docstring='The newest release of each service compared with the release before it') ReleaseComparison(lookback:timespan=7d) {
    ReleaseHealth(lookback)
    | partition hint.strategy=native by Service (
        partition hint.strategy=native by Environment (
            order by LastSeen desc
            | take 2
            | extend Rank=row_number()
        )
    )
    | summarize Current=take_anyif(Version, Rank == 1), Previous=take_anyif(Version, Rank == 2),
        CurrentErrorFreeRate=take_anyif(ErrorFreeRate, Rank == 1), PreviousErrorFreeRate=take_anyif(ErrorFreeRate, Rank == 2),
        CurrentP95Ms=take_anyif(P95Ms, Rank == 1), PreviousP95Ms=take_anyif(P95Ms, Rank == 2),
        CurrentTier=take_anyif(Tier, Rank == 1), NewIssues=take_anyif(NewIssues, Rank == 1)
        by Service, Environment
    | extend ErrorFreeDelta=round(CurrentErrorFreeRate - PreviousErrorFreeRate, 4), P95DeltaMs=round(CurrentP95Ms - PreviousP95Ms, 1)
    | extend Verdict=case(isempty(Previous), "first release", CurrentTier == "too few requests", "too few requests", ErrorFreeDelta <= -0.01, "worse", ErrorFreeDelta >= 0.01, "better", "same")
}

// ---------------------------------------------------------------------------
// AI agents: runs, models, tools, and a per-run waterfall from OpenTelemetry
// GenAI spans (invoke_agent, chat, execute_tool). Token counts only: no cost,
// because model prices change faster than a dashboard does. No prompt or
// completion text is stored; the collector drops it.
// ---------------------------------------------------------------------------

.create-or-alter function with (folder='Agents', docstring='GenAI spans with operation, agent, model, tool, tokens, duration, and status') AgentSpans(lookback:timespan=1h) {
    OTELTraces
    | where StartTime > ago(lookback)
    | where ResourceAttributes["demo.synthetic"] == true and isnotempty(TraceAttributes["gen_ai.operation.name"])
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), Version=tostring(ResourceAttributes["service.version"])
    | extend Operation=tostring(TraceAttributes["gen_ai.operation.name"]), Agent=tostring(TraceAttributes["gen_ai.agent.name"]), Model=tostring(coalesce(TraceAttributes["gen_ai.response.model"], TraceAttributes["gen_ai.request.model"])), Tool=tostring(TraceAttributes["gen_ai.tool.name"])
    | extend InputTokens=tolong(TraceAttributes["gen_ai.usage.input_tokens"]), OutputTokens=tolong(TraceAttributes["gen_ai.usage.output_tokens"]), FinishReasons=TraceAttributes["gen_ai.response.finish_reasons"]
    | extend DurationMs=(EndTime - StartTime) / 1ms, Failed=SpanStatus == "STATUS_CODE_ERROR"
    | project StartTime, EndTime, TraceID, SpanID, ParentID, SpanName, Service, Environment, Version, Operation, Agent, Model, Tool, InputTokens, OutputTokens, FinishReasons, DurationMs, Failed
}

.create-or-alter function with (folder='Agents', docstring='One row per agent run (trace): agents involved, model and tool calls, tokens, duration, and outcome') AgentRuns(lookback:timespan=1h) {
    let spans = AgentSpans(lookback);
    let entry = spans
        | where Operation == "invoke_agent"
        | summarize arg_min(StartTime, Agent) by TraceID
        | project TraceID, EntryAgent=Agent;
    spans
    | summarize Start=min(StartTime), End=max(EndTime), Agents=make_set_if(Agent, Operation == "invoke_agent"), Models=make_set_if(Model, Operation == "chat"), Tools=make_set_if(Tool, Operation == "execute_tool"),
        ModelCalls=countif(Operation == "chat"), ToolCalls=countif(Operation == "execute_tool"), InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens),
        Failed=max(toint(Failed)) == 1, Environment=take_any(Environment), Version=take_any(Version) by TraceID
    | join kind=leftouter entry on TraceID
    | extend DurationMs=(End - Start) / 1ms, Handoff=array_length(Agents) > 1
    | project Start, TraceID, Environment, Version, EntryAgent, Agents, Handoff, Models, Tools, ModelCalls, ToolCalls, InputTokens, OutputTokens, DurationMs, Failed
    | order by Start desc
}

.create-or-alter function with (folder='Agents', docstring='Agent runs per minute with failures and approximate p50 and p95 run duration') AgentOverview(lookback:timespan=1h) {
    AgentRuns(lookback)
    | summarize Runs=count(), FailedRuns=countif(Failed), Handoffs=countif(Handoff), InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens), P50Ms=percentile(DurationMs, 50), P95Ms=percentile(DurationMs, 95) by WindowStart=bin(Start, 1m), Environment
}

.create-or-alter function with (folder='Agents', docstring='Model calls, token usage, errors, and latency by model') AgentModels(lookback:timespan=1h) {
    AgentSpans(lookback)
    | where Operation == "chat"
    | summarize Calls=count(), Errors=countif(Failed), InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens), P95Ms=round(percentile(DurationMs, 95), 1) by Model, Environment
    | extend TotalTokens=InputTokens + OutputTokens, ErrorRate=round(todouble(Errors) / Calls, 4)
    | order by TotalTokens desc
}

.create-or-alter function with (folder='Agents', docstring='Tool calls, errors, and latency by tool and agent') AgentTools(lookback:timespan=1h) {
    AgentSpans(lookback)
    | where Operation == "execute_tool"
    | summarize Calls=count(), Errors=countif(Failed), P95Ms=round(percentile(DurationMs, 95), 1) by Tool, Agent, Environment
    | extend ErrorRate=round(todouble(Errors) / Calls, 4)
    | order by Calls desc
}

.create-or-alter function with (folder='Agents', docstring='Every model call, tool call, and handoff in one agent run, in order, with offsets for a waterfall') AgentRun(traceId:string) {
    let spans = OTELTraces
        | where TraceID == traceId and StartTime > ago(7d)
        | extend Operation=tostring(TraceAttributes["gen_ai.operation.name"]);
    let runStart = toscalar(spans | summarize min(StartTime));
    spans
    | extend Service=tostring(ResourceAttributes["service.name"]), Agent=tostring(TraceAttributes["gen_ai.agent.name"]), Model=tostring(coalesce(TraceAttributes["gen_ai.response.model"], TraceAttributes["gen_ai.request.model"])), Tool=tostring(TraceAttributes["gen_ai.tool.name"])
    | extend Step=case(Operation == "invoke_agent", strcat("agent ", Agent), Operation == "chat", strcat("model ", Model), Operation == "execute_tool", strcat("tool ", Tool), strcat(Service, " ", SpanName))
    | extend OffsetMs=(StartTime - runStart) / 1ms, DurationMs=(EndTime - StartTime) / 1ms, InputTokens=tolong(TraceAttributes["gen_ai.usage.input_tokens"]), OutputTokens=tolong(TraceAttributes["gen_ai.usage.output_tokens"])
    | project StartTime, Step, SpanName, Operation, Service, Agent, Model, Tool, OffsetMs, DurationMs, InputTokens, OutputTokens, Status=SpanStatus, SpanID, ParentID
    | order by StartTime asc
}

// ---------------------------------------------------------------------------
// Investigation toolbox: task-shaped functions for AI agents and people. An MCP
// client calls these by name instead of writing KQL against the raw tables.
// ---------------------------------------------------------------------------

.create-or-alter function with (folder='Toolbox', docstring='Health per service and environment: requests, error rate, p95, open issues, last seen, and a tier') ServiceHealth(lookback:timespan=1h) {
    let openIssues = Issues(lookback)
        | where Status != "resolved"
        | summarize OpenIssues=dcount(Fingerprint) by Service, Environment;
    Releases1m
    | where WindowStart > ago(lookback)
    | summarize Requests=sum(RequestCount), Errors=sum(ErrorCount), Digest=tdigest_merge(DurationDigest), LastSeen=max(LastSeen), Versions=make_set(Version) by Service, Environment
    | extend ErrorRate=round(todouble(Errors) / Requests, 4), P95Ms=round(todouble(percentiles_array_tdigest(Digest, dynamic([95]))[0]), 1)
    | join kind=leftouter openIssues on Service, Environment
    | extend OpenIssues=coalesce(OpenIssues, 0)
    | extend Tier=case(Requests < 50, "too few requests", ErrorRate <= 0.01, "healthy", ErrorRate <= 0.05, "degraded", "unhealthy")
    | project Service, Environment, Tier, Requests, Errors, ErrorRate, P95Ms, OpenIssues, Versions, LastSeen
    | order by ErrorRate desc
}

.create-or-alter function with (folder='Toolbox', docstring='The n unresolved issues with the most events in the lookback window') TopIssues(lookback:timespan=24h, n:long=10) {
    Issues(lookback)
    | where Status != "resolved"
    | top n by Events desc
    | project Fingerprint, Title, Culprit, Environment, Status, Events, FirstSeen, LastSeen, IntroducedIn, Versions, ExampleTraceID
}

.create-or-alter function with (folder='Toolbox', docstring='Recent occurrences of one issue with trace IDs, versions, and run IDs for drill-down') IssueDetail(fingerprint:string, lookback:timespan=24h) {
    ErrorEvents(lookback)
    | where Fingerprint == fingerprint
    | top 50 by Timestamp desc
    | project Timestamp, Title=strcat(ExceptionType, ": ", Message), Service, Environment, Version, SpanName, TraceID, SpanID, RunID
}

.create-or-alter function with (folder='Toolbox', docstring='Every span of one trace with offsets, status, exception, and correlated log count') TraceDetail(traceId:string) {
    let spans = OTELTraces
        | where TraceID == traceId and StartTime > ago(7d);
    let runStart = toscalar(spans | summarize min(StartTime));
    let logs = OTELLogs
        | where TraceID == traceId and Timestamp > ago(7d)
        | summarize Logs=count(), ErrorLogs=countif(SeverityNumber >= 17) by SpanID;
    spans
    | mv-apply Event=Events to typeof(dynamic) on (
        summarize ExceptionType=take_anyif(tostring(Event.EventAttributes["exception.type"]), tostring(Event.EventName) == "exception"),
            ExceptionMessage=take_anyif(tostring(Event.EventAttributes["exception.message"]), tostring(Event.EventName) == "exception")
    )
    | join kind=leftouter logs on SpanID
    | extend Service=tostring(ResourceAttributes["service.name"]), OffsetMs=(StartTime - runStart) / 1ms, DurationMs=(EndTime - StartTime) / 1ms
    | project StartTime, Service, SpanName, SpanKind, Status=SpanStatus, OffsetMs, DurationMs, ExceptionType, ExceptionMessage, Logs=coalesce(Logs, 0), ErrorLogs=coalesce(ErrorLogs, 0), SpanID, ParentID
    | order by StartTime asc
}

.create-or-alter function with (folder='Toolbox', docstring='The newest failed spans with their issue, optionally for one service (empty for all)') RecentErrors(service:string="", lookback:timespan=1h) {
    ErrorEvents(lookback)
    | where isempty(service) or Service == service
    | top 50 by Timestamp desc
    | project Timestamp, Service, Environment, Version, SpanName, Title=strcat(ExceptionType, ": ", Message), Fingerprint, TraceID
}

// ---------------------------------------------------------------------------
// Telemetry volume: what drives ingestion and storage on the capacity.
// ---------------------------------------------------------------------------

.create-or-alter function with (folder='Toolbox', docstring='Rows and estimated uncompressed bytes per hour, signal, service, and environment') TelemetryVolume(lookback:timespan=24h) {
    union
        (OTELTraces | where StartTime > ago(lookback) | extend Signal="traces", Time=StartTime),
        (OTELLogs | where Timestamp > ago(lookback) | extend Signal="logs", Time=Timestamp),
        (OTELMetrics | where Timestamp > ago(lookback) | extend Signal="metrics", Time=Timestamp)
    | extend Service=tostring(ResourceAttributes["service.name"]), Environment=tostring(ResourceAttributes["deployment.environment.name"]), Bytes=estimate_data_size(*)
    | summarize Rows=count(), EstimatedBytes=sum(Bytes) by WindowStart=bin(Time, 1h), Signal, Service, Environment
}

.create-or-alter function with (folder='Toolbox', docstring='Oldest and newest stored row and row count per raw table, showing the retention in effect') TelemetryCoverage() {
    union
        (OTELTraces | summarize Rows=count(), Oldest=min(ingestion_time()), Newest=max(ingestion_time()) | extend Table="OTELTraces"),
        (OTELLogs | summarize Rows=count(), Oldest=min(ingestion_time()), Newest=max(ingestion_time()) | extend Table="OTELLogs"),
        (OTELMetrics | summarize Rows=count(), Oldest=min(ingestion_time()), Newest=max(ingestion_time()) | extend Table="OTELMetrics")
    | extend StoredDays=round((Newest - Oldest) / 1d, 1)
    | project Table, Rows, Oldest, Newest, StoredDays
}
