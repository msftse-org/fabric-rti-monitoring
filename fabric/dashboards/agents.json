      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_agent_kpis\n| project P95RunMs",
      "usedVariables": [
        "_agent_kpis"
      ]
    },
    {
      "id": "d1a12cdc-04c0-5c61-885b-ea3b6c15d363",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentRuns(now() - _startTime)\n| where Start between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize ok=countif(not(Failed)), failed=countif(Failed) by WindowStart=bin(Start, 1m)\n| order by WindowStart asc",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "95d6e3ed-0f20-550e-b5b8-ade4ce898040",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentSpans(now() - _startTime)\n| where StartTime between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| where Operation == \"chat\"\n| summarize Tokens=sum(InputTokens + OutputTokens) by WindowStart=bin(StartTime, 1m), Model\n| order by WindowStart asc",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "87219de4-62e1-5c05-a961-28954e4fb9e2",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentSpans(now() - _startTime)\n| where StartTime between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| where Operation == \"chat\"\n| summarize Calls=count(), Errors=countif(Failed), InputTokens=sum(InputTokens), OutputTokens=sum(OutputTokens),\n    P95Ms=round(percentile(DurationMs, 95), 1) by Model, Environment\n| order by Calls desc\n| take 50",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "69bf2628-4374-5cb7-a177-dc600b7ebb24",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentSpans(now() - _startTime)\n| where StartTime between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| where Operation == \"execute_tool\"\n| summarize Calls=count(), Errors=countif(Failed), P95Ms=round(percentile(DurationMs, 95), 1) by Tool, Agent, Environment\n| extend ErrorRate=round(todouble(Errors) / Calls, 4)\n| order by Calls desc\n| take 50",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "1e7e9b97-6c6f-5c05-b21e-c2971e2311dd",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentRuns(now() - _startTime)\n| where Start between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| top 100 by Start desc\n| project Start, Outcome=iff(Failed, \"failed\", \"ok\"), EntryAgent, Agents=strcat_array(Agents, \" > \"),\n    Tools=strcat_array(Tools, \", \"), ModelCalls, ToolCalls, InputTokens, OutputTokens, DurationMs=round(DurationMs, 0), TraceID",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "e8b9a06d-05d9-5790-87a8-94fbd47906ab",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "let selected_trace = _run;\nAgentRun(selected_trace)\n| where StartTime between ((_startTime - 5m) .. (_endTime + 5m))\n| project Step, Operation, OffsetMs=round(OffsetMs, 1), DurationMs=round(DurationMs, 1), InputTokens, OutputTokens, Status\n| take 200",
      "usedVariables": [
        "_endTime",
        "_run",
        "_startTime"
      ]
    }
