  "queries": [
    {
      "id": "5212702c-b8fc-5569-9b45-d27d466478fe",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "OTELTraces\n| where StartTime between (_startTime .. _endTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| distinct Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| order by Environment asc",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "id": "2de1902d-7864-5849-9a62-143c0232cdd7",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentRuns(now() - _startTime)\n| where Start between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize Runs=count(), FailedRuns=countif(Failed), Handoffs=countif(Handoff),\n    Tokens=sum(InputTokens + OutputTokens), P95RunMs=round(percentile(DurationMs, 95), 0)",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "f45bed3a-a65d-5ce2-8872-5ce6567fcbd7",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "AgentRuns(now() - _startTime)\n| where Start between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| top 200 by Start desc\n| project TraceID, Label=strcat(format_datetime(Start, \"HH:mm:ss\"), \" · \", strcat_array(Agents, \" > \"), \" · \", iff(Failed, \"failed\", \"ok\"))",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
