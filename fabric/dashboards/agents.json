      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_agent_kpis\n| project Runs",
      "usedVariables": [
        "_agent_kpis"
      ]
    },
    {
      "id": "07a65612-a693-57f9-8972-d5ddc8ef50a3",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
