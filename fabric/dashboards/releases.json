  "queries": [
    {
      "id": "ec4b235e-0985-504d-b0d4-3115cc4b5dda",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "OTELTraces\n| where StartTime between (_startTime .. _endTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| distinct Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| order by Environment asc",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "id": "d02efe87-5308-55e5-97e7-c799d14c5daa",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "ReleaseHealth(now() - _startTime)\n| where LastSeen between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize Releases=count(), Unhealthy=countif(Tier == \"unhealthy\"), NewIssues=sum(NewIssues)",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "d607d1bb-1d8c-52d7-9cdd-aafea9ac6c74",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_release_kpis\n| project Releases",
      "usedVariables": [
        "_release_kpis"
      ]
    },
    {
      "id": "b78c7df3-d62a-575a-9149-5aefbe680697",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_release_kpis\n| project Unhealthy",
      "usedVariables": [
        "_release_kpis"
      ]
    },
    {
      "id": "1e47bb5d-91c6-522d-998e-cd6d47d45cf2",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_release_kpis\n| project NewIssues",
      "usedVariables": [
        "_release_kpis"
      ]
    },
    {
      "id": "1e35322b-489e-51d9-80ac-2584d427e6be",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "ReleaseComparison(now() - _startTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| project Verdict, Service, Environment, Previous, Current, PreviousErrorFreeRate, CurrentErrorFreeRate, ErrorFreeDelta,\n    PreviousP95Ms, CurrentP95Ms, P95DeltaMs, NewIssues\n| take 200",
      "usedVariables": [
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "dd5761fd-d39b-5481-bc5e-f8203f87fc39",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "ReleaseHealth(now() - _startTime)\n| where LastSeen between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| project Tier, Service, Environment, Version, ErrorFreeRate, Requests, Errors, P95Ms, NewIssues, FirstSeen, LastSeen\n| take 200",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "ef35f996-fd85-50b9-ba1e-709ddf60e158",
      "dataSource": {
        "kind": "inline",
