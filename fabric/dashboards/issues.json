      "id": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1",
      "kind": "kusto-trident",
      "name": "observability",
      "clusterUri": "https://<eventhouse>.kusto.fabric.microsoft.com",
      "databaseArtifactId": "00000000-0000-0000-0000-000000000000",
      "database": "00000000-0000-0000-0000-000000000000",
      "workspace": "00000000-0000-0000-0000-000000000000"
    }
