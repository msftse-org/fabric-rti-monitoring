  ],
  "queries": [
    {
      "id": "0ff484bc-a3ba-5014-a03a-a6d02f469c23",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "OTELTraces\n| where StartTime between (_startTime .. _endTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| distinct Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| order by Environment asc",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "id": "ca1bc6d2-7e95-567e-b97c-255c477b7711",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "Issues(now() - _startTime)\n| where LastSeen between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize Issues=dcount(Fingerprint), Unresolved=dcountif(Fingerprint, Status != \"resolved\"),\n    New=dcountif(Fingerprint, FirstSeen >= _startTime), Events=sum(Events)",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "f1ad4c79-5b41-58ed-91b8-5cb076561770",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "Issues(now() - _startTime)\n| where LastSeen between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize Events=sum(Events) by Fingerprint, Title\n| top 200 by Events desc\n| project Fingerprint, Label=strcat(Title, \" · \", Events, \" events\")",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "d082ac8a-19d3-5419-a379-117ac0ed2058",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_issue_kpis\n| project Issues",
      "usedVariables": [
        "_issue_kpis"
      ]
    },
    {
      "id": "0b73f7ce-abed-5072-8b81-21d75556da1e",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_issue_kpis\n| project Unresolved",
      "usedVariables": [
        "_issue_kpis"
      ]
    },
    {
      "id": "5c6630fd-a995-542c-b0cc-e6d5cf44714a",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_issue_kpis\n| project New",
      "usedVariables": [
        "_issue_kpis"
      ]
    },
    {
      "id": "742618dc-be15-5b49-a695-9b8305b3d34a",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_issue_kpis\n| project Events",
      "usedVariables": [
        "_issue_kpis"
      ]
    },
    {
      "id": "dcf33d3c-487b-5e68-80ab-3690a730a333",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "let top_issues = Issues1h\n| where WindowStart between (bin(_startTime, 1h) .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| summarize Events=sum(EventCount) by Fingerprint\n| top 10 by Events;\nIssues1h\n| where WindowStart between (bin(_startTime, 1h) .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| where Fingerprint in ((top_issues | project Fingerprint))\n| summarize Events=sum(EventCount) by WindowStart, Issue=strcat(ExceptionType, \": \", Message)\n| order by WindowStart asc",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "c03f1f87-246e-5140-87d4-b7ff3d7ee979",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "Issues(now() - _startTime)\n| where LastSeen between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| project Status, Title, Culprit, Environment, Events, FirstSeen, LastSeen, IntroducedIn,\n    Versions=strcat_array(Versions, \", \"), Fingerprint, ExampleTraceID\n| order by Events desc\n| take 200",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "c2d79750-1fa0-5651-bb5b-f716aa6ca089",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "IssueAlerts(now() - _startTime)\n| where LastEvent between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| project AlertType, Title, Service, Environment, Events, FirstEvent, LastEvent, Fingerprint, ExampleTraceID\n| take 200",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_service",
        "_startTime"
      ]
    },
    {
      "id": "6f9263ac-c576-525f-bbf4-e3509dc54df1",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "ErrorEvents(now() - _startTime)\n| where Timestamp between (_startTime .. _endTime)\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| where Fingerprint == _issue\n| top 50 by Timestamp desc\n| project Timestamp, Service, Version, SpanName, Title=strcat(ExceptionType, \": \", Message), TraceID",
      "usedVariables": [
        "_endTime",
        "_environment",
        "_issue",
        "_service",
        "_startTime"
      ]
    }
  ],
  "embeddedApps": []
}
