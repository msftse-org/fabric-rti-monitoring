  "queries": [
    {
      "id": "9416bc08-ecf1-546e-8e5f-04696d72b861",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "OTELTraces\n| where StartTime between (_startTime .. _endTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| distinct Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| order by Environment asc",
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "dade5a62-f7f8-5f2d-b248-fe0293d113e1",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "OTELLogs\n| where Timestamp between (_startTime .. _endTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where (isempty(_environment) or Environment in (_environment))\n| where (isempty(_service) or Service in (_service))\n| extend Scenario=tostring(LogsAttributes[\"demo.scenario\"]), Outcome=tostring(LogsAttributes[\"outcome\"])\n| summarize Lines=count(), Errors=countif(SeverityNumber >= 17), Services=dcount(Service), Newest=max(Timestamp)\n| project LinesPerMinute=round(Lines / max_of(1.0, (_endTime - _startTime) / 1m), 1), ErrorLines=Errors,\n    ErrorPercent=round(iff(Lines == 0, real(null), 100.0 * Errors / Lines), 2), Services,\n    SecondsSinceLastLog=tolong((now() - Newest) / 1s)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_environment",
        "_service"
      ]
    },
    {
      "id": "052c6aca-cdc3-5228-b657-312282bf9e76",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_log_kpis\n| project LinesPerMinute",
      "usedVariables": [
        "_log_kpis"
      ]
    },
    {
      "id": "c3bac0b2-0e2b-52ca-9af5-50665e4cc6b9",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_log_kpis\n| project ErrorLines",
      "usedVariables": [
        "_log_kpis"
      ]
    },
    {
      "id": "5cd5120d-537f-5189-84ea-f61304a98033",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_log_kpis\n| project ErrorPercent",
      "usedVariables": [
        "_log_kpis"
      ]
    },
    {
      "id": "c8e0714c-8cd3-5144-b9fa-f17c85ca55a1",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "4a400d92-1a3d-56cd-b113-9a7b41dea4f1"
      },
      "text": "_log_kpis\n| project Services",
      "usedVariables": [
        "_log_kpis"
      ]
    },
    {
      "id": "8c92dea1-c919-54a0-aa6e-a3b893caa22f",
