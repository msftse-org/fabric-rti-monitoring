          "show": false
        }
      }
    },
    {
      "id": 6,
      "title": "Recent runs",
      "description": "Newest 100 runs. Select a TraceID for its steps below, or open the full waterfall.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "let runs = AgentSpans(now() - $__timeFrom)\n| where $__timeFilter(StartTime)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| distinct TraceID;\nAgentRuns(now() - $__timeFrom)\n| where TraceID in (runs)\n| project Start, Outcome=iff(Failed, \"failed\", \"success\"), EntryAgent, Agents=strcat_array(Agents, \" > \"), Tools=strcat_array(Tools, \", \"), ModelCalls, ToolCalls, InputTokens, OutputTokens, DurationMs, TraceID\n| top 100 by Start desc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "failed": {
                        "text": "failed",
                        "color": "red",
                        "index": 0
                      },
                      "success": {
                        "text": "success",
                        "color": "green",
