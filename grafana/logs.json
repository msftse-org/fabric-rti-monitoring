      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "logs",
      "version": ""
    },
    {
      "type": "panel",
