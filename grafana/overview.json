{
  "__inputs": [
    {
      "name": "DS_FABRIC",
      "label": "Fabric Eventhouse",
      "description": "Azure Data Explorer datasource configured for this demo KQL database",
      "type": "datasource",
      "pluginId": "grafana-azure-data-explorer-datasource",
      "pluginName": "Azure Data Explorer Datasource"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-azure-data-explorer-datasource",
      "name": "Azure Data Explorer Datasource",
      "version": "6.0.0"
    }
  ],
  "id": null,
  "uid": "fabric-rti-overview",
  "title": "Fabric Real-Time Observability",
  "description": "Synthetic logs, traces and metrics with materialized-view serving queries.",
  "tags": [
    "fabric",
    "opentelemetry",
    "synthetic"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "KQL database",
        "type": "textbox",
        "query": "Observability",
        "current": {
          "text": "Observability",
          "value": "Observability"
        },
        "hide": 0
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Follow the signals",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic demo** - Request and log charts query materialized views through serving functions. Detail tables query raw data. Select a TraceID in recent logs to inspect its parent and child spans. Rollups retain 30 days; raw detail retains 7 days. Missing data is shown as missing, not zero."
      }
    },
    {
      "id": 2,
      "title": "Requests per minute",
      "description": "Root spans only. Counts include retries or duplicates if the producer resends.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "RequestsOverview(30d)\n| where $__timeFilter(WindowStart)\n| project WindowStart, Requests=RequestCount, Service\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Root request latency",
      "description": "Approximate percentiles calculated from the Requests1m tdigest rollup.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "RequestsOverview(30d)\n| where $__timeFilter(WindowStart)\n| project WindowStart, P50Ms, P95Ms\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Logs per minute",
      "description": "Counts come from Logs1m. Errors have severity number >= 17.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "LogsOverview(30d)\n| where $__timeFilter(WindowStart)\n| project WindowStart, Logs=LogCount, Errors=ErrorCount\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Duration metric samples",
      "description": "Gauge sample averages and maxima from Metrics1m. These are not a request rate.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "MetricDurationOverview(30d)\n| where $__timeFilter(WindowStart)\n| project WindowStart, AverageMs, MaximumMs\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Recent correlated logs",
      "description": "Select a trace ID to inspect its two spans below. Limited to the newest 100 rows.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "OTELLogs\n| where $__timeFilter(Timestamp)\n| project Timestamp, SeverityText, Body, TraceID, SpanID\n| order by Timestamp desc\n| take 100",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "TraceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect trace",
                    "url": "?var-trace_id=${__value.raw}&var-database=${database}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "title": "Trace detail",
      "description": "Enter a trace ID or select one from recent logs. ParentID reconstructs the request and storage span relationship.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "let selected_trace = ${trace_id:singlequote};\nOTELTraces\n| where $__timeFilter(StartTime)\n| where isnotempty(selected_trace) and TraceID == selected_trace\n| project StartTime, DurationMs=(EndTime-StartTime)/1ms, SpanName, SpanID, ParentID, SpanStatus\n| order by StartTime asc\n| take 100",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
