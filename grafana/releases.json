  "panels": [
    {
      "id": 1,
      "title": "Newest release vs previous",
      "description": "Verdict compares the error-free rate of each service's newest version with the version before it.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "ReleaseComparison(now() - $__timeFrom)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| project Verdict, Service, Environment, Previous, Current, PreviousErrorFreeRate, CurrentErrorFreeRate, ErrorFreeDelta, PreviousP95Ms, CurrentP95Ms, P95DeltaMs, NewIssues\n| take 100",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Verdict"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "worse": {
                        "text": "worse",
                        "color": "red",
                        "index": 0
                      },
                      "better": {
                        "text": "better",
                        "color": "green",
                        "index": 1
                      },
                      "same": {
                        "text": "same",
                        "color": "text",
                        "index": 2
                      },
                      "first release": {
                        "text": "first release",
                        "color": "blue",
                        "index": 3
                      },
                      "too few requests": {
                        "text": "too few requests",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PreviousErrorFreeRate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CurrentErrorFreeRate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PreviousP95Ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CurrentP95Ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ErrorFreeDelta"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "title": "Release health",
      "description": "Healthy at 99% error-free or more, degraded at 95%, unhealthy below; fewer than 50 requests reads too few requests.",
      "type": "table",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "ReleaseHealth(now() - $__timeFrom)\n| where $__timeFilter(LastSeen)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| project Tier, Service, Environment, Version, ErrorFreeRate, Requests, Errors, P95Ms, NewIssues, FirstSeen, LastSeen\n| take 200",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tier"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "healthy": {
                        "text": "healthy",
                        "color": "green",
                        "index": 0
                      },
                      "degraded": {
                        "text": "degraded",
                        "color": "orange",
                        "index": 1
                      },
                      "unhealthy": {
                        "text": "unhealthy",
                        "color": "red",
                        "index": 2
                      },
                      "too few requests": {
                        "text": "too few requests",
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ErrorFreeRate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95Ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 3000
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "title": "Error-free rate by version",
      "description": "Five-minute error-free rate of server spans per environment and version.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "Releases1m\n| where $__timeFilter(WindowStart)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| summarize Requests=sum(RequestCount), Errors=sum(ErrorCount), Digest=tdigest_merge(DurationDigest) by WindowStart=bin(WindowStart, 5m), Environment, Version\n| project WindowStart, ErrorFreeRate=1.0 - todouble(Errors) / Requests, Series=strcat(Environment, \" / \", Version)\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "displayName": "${__field.labels.Series}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "p95 latency by version",
      "description": "Approximate five-minute p95 of server spans per environment and version.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "Releases1m\n| where $__timeFilter(WindowStart)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| summarize Requests=sum(RequestCount), Errors=sum(ErrorCount), Digest=tdigest_merge(DurationDigest) by WindowStart=bin(WindowStart, 5m), Environment, Version\n| project WindowStart, P95Ms=todouble(percentiles_array_tdigest(Digest, dynamic([95]))[0]), Series=strcat(Environment, \" / \", Version)\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "displayName": "${__field.labels.Series}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
