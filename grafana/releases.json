  "id": null,
  "uid": "fabric-rti-releases",
  "title": "Fabric RTI Releases",
  "description": "Release health per service version: error-free rate, p95 latency, issues introduced, and the newest release compared with the previous one.",
  "tags": [
    "fabric-rti",
    "releases"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Fabric RTI",
      "type": "dashboards",
      "tags": [
        "fabric-rti"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "KQL database",
        "type": "textbox",
        "query": "Observability",
        "description": "Eventhouse KQL database that stores the OTEL tables.",
        "current": {
          "text": "Observability",
          "value": "Observability"
        },
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "description": "",
        "query": "All environments : all, AKS : aks, Container Apps job : demo",
        "current": {
          "text": "All environments",
          "value": "all"
        },
        "options": [
          {
            "text": "All environments",
            "value": "all",
            "selected": true
          },
          {
            "text": "AKS",
            "value": "aks",
            "selected": false
          },
          {
            "text": "Container Apps job",
            "value": "demo",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "description": "",
        "query": "All services : all, gateway : gateway, checkout : checkout, inventory : inventory, payment : payment, shipping : shipping, notifications : notifications, assistant : assistant, postgres : postgres",
        "current": {
          "text": "All services",
          "value": "all"
        },
        "options": [
          {
            "text": "All services",
            "value": "all",
            "selected": true
          },
          {
            "text": "gateway",
            "value": "gateway",
            "selected": false
          },
          {
            "text": "checkout",
            "value": "checkout",
            "selected": false
          },
          {
            "text": "inventory",
            "value": "inventory",
            "selected": false
          },
          {
            "text": "payment",
            "value": "payment",
            "selected": false
          },
          {
            "text": "shipping",
            "value": "shipping",
            "selected": false
          },
          {
            "text": "notifications",
            "value": "notifications",
            "selected": false
          },
          {
            "text": "assistant",
            "value": "assistant",
            "selected": false
          },
          {
            "text": "postgres",
            "value": "postgres",
            "selected": false
          }
