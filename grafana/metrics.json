    {
      "id": 7,
      "title": "Gateway latency p50 / p95",
      "description": "Root request latency from the Requests1m materialized view (approximate percentiles). Only the gateway serves root requests.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 8,
