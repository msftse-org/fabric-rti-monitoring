            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "OTELMetrics\n| where $__timeFilter(Timestamp)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| extend Pod=tostring(ResourceAttributes[\"k8s.pod.name\"]), Scenario=tostring(MetricAttributes[\"demo.scenario\"]),\n    Outcome=tostring(MetricAttributes[\"outcome\"])\n| where MetricName == \"demo.requests\"\n| summarize Requests=sum(MetricValue) by WindowStart=bin(Timestamp, 1m), Environment, Outcome\n| project WindowStart, Requests, Series=strcat(Environment, \" / \", Outcome)\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
