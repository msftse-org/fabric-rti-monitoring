      "id": 10,
      "title": "Telemetry volume",
      "description": "Estimated uncompressed megabytes ingested per hour by signal: the main driver of ingestion on the capacity.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
