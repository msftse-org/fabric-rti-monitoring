          "database": "$database",
          "query": "let minutes = max_of(1.0, ($__timeTo - $__timeFrom) / 1m);\nOTELTraces\n| where $__timeFilter(StartTime)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where SpanKind == \"SPAN_KIND_SERVER\"\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| extend DurationMs=(EndTime - StartTime) / 1ms\n| summarize Requests=count(), Errors=countif(SpanStatus == \"STATUS_CODE_ERROR\"),\n    P50Ms=percentile(DurationMs, 50), P95Ms=percentile(DurationMs, 95),\n    LastSeen=max(StartTime), Pods=dcount(tostring(ResourceAttributes[\"k8s.pod.name\"]))\n    by Service, Environment\n| extend Hop=array_index_of(dynamic([\"gateway\", \"checkout\", \"inventory\", \"payment\", \"shipping\", \"notifications\"]), Service)\n| order by Environment asc, Hop asc\n| project Service, Environment, RequestsPerMinute=Requests / minutes, Errors, ErrorPercent=100.0 * Errors / Requests,\n    P50Ms, P95Ms, LastSeen, Pods\n| take 100",
