  "panels": [
    {
      "id": 1,
      "title": "Golden signals",
      "description": "From the demo.requests counter and demo.request.duration gauge. Throughput counts every service hop, so choose gateway for user-facing traffic.",
      "type": "stat",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "let minutes = max_of(1.0, ($__timeTo - $__timeFrom) / 1m);\nOTELMetrics\n| where $__timeFilter(Timestamp)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| extend Pod=tostring(ResourceAttributes[\"k8s.pod.name\"]), Scenario=tostring(MetricAttributes[\"demo.scenario\"]),\n    Outcome=tostring(MetricAttributes[\"outcome\"])\n| summarize Requests=sumif(MetricValue, MetricName == \"demo.requests\"),\n    MeanMs=take_anyif(MetricValue, MetricName == \"demo.request.duration\")\n    by Timestamp, Service, Environment, Pod, Scenario, Outcome\n| summarize Requests=sum(Requests), Errors=sumif(Requests, Outcome == \"error\"),\n    WeightedMs=sumif(MeanMs * Requests, isnotnull(MeanMs)), Weighted=sumif(Requests, isnotnull(MeanMs)),\n    Pods=dcountif(Pod, isnotempty(Pod)), Newest=max(Timestamp)\n| project RequestsPerMinute=Requests / minutes, ErrorPercent=iff(Requests == 0, real(null), 100.0 * Errors / Requests),\n    MeanLatencyMs=iff(Weighted == 0, real(null), WeightedMs / Weighted), Pods, NewestSampleAgeSeconds=(now() - Newest) / 1s",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RequestsPerMinute"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests / min"
              },
              {
                "id": "unit",
                "value": "suffix: req/min"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ErrorPercent"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Error rate"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MeanLatencyMs"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Mean latency"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 500
                    },
                    {
                      "color": "red",
                      "value": 1000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pods"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Reporting pods"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "NewestSampleAgeSeconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Newest sample age"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "title": "Requests per minute",
      "description": "Sum of the demo.requests delta counter per service. Gaps mean no export, not zero traffic.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "OTELMetrics\n| where $__timeFilter(Timestamp)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| extend Pod=tostring(ResourceAttributes[\"k8s.pod.name\"]), Scenario=tostring(MetricAttributes[\"demo.scenario\"]),\n    Outcome=tostring(MetricAttributes[\"outcome\"])\n| where MetricName == \"demo.requests\"\n| summarize Requests=sum(MetricValue) by WindowStart=bin(Timestamp, 1m), Service, Environment\n| project WindowStart, Requests, Series=strcat(Environment, \" / \", Service)\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "displayName": "${__field.labels.Series}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Error rate",
      "description": "Share of demo.requests with outcome=error, per service.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-azure-data-explorer-datasource",
        "uid": "${DS_FABRIC}"
      },
      "gridPos": {
        "x": 12,
