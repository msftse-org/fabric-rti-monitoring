          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "TelemetryVolume(now() - $__timeFrom)\n| where $__timeFilter(WindowStart)\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| summarize MB=sum(EstimatedBytes) / 1e6 by WindowStart, Environment, Signal\n| project WindowStart, MB, Series=strcat(Environment, \" / \", Signal)\n| order by WindowStart asc",
