      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-data-explorer-datasource",
            "uid": "${DS_FABRIC}"
          },
          "database": "$database",
          "query": "OTELMetrics\n| where $__timeFilter(Timestamp)\n| where ResourceAttributes[\"demo.synthetic\"] == true\n| extend Service=tostring(ResourceAttributes[\"service.name\"]), Environment=tostring(ResourceAttributes[\"deployment.environment.name\"])\n| where ${environment:singlequote} == \"all\" or Environment == ${environment:singlequote}\n| where ${service:singlequote} == \"all\" or Service == ${service:singlequote}\n| extend Pod=tostring(ResourceAttributes[\"k8s.pod.name\"]), Scenario=tostring(MetricAttributes[\"demo.scenario\"]),\n    Outcome=tostring(MetricAttributes[\"outcome\"])\n| where MetricName == \"demo.requests\"\n| summarize Requests=sum(MetricValue), Errors=sumif(MetricValue, Outcome == \"error\")\n    by WindowStart=bin(Timestamp, 1m), Service, Environment\n| project WindowStart, ErrorPercent=100.0 * Errors / Requests, Series=strcat(Environment, \" / \", Service)\n| order by WindowStart asc",
          "querySource": "raw",
          "queryType": "KQL",
          "rawMode": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "${__field.labels.Series}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
