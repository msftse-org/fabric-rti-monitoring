targetScope = 'resourceGroup'

@description('Azure region. Verify that both Fabric and Managed Grafana are available here.')
param location string = resourceGroup().location

@description('Opt in to a new, billable Fabric capacity. Leave false when using an existing capacity or trial.')
param deployFabricCapacity bool = false

@description('Globally unique capacity name: lowercase letters and digits, beginning with a letter.')
@minLength(3)
@maxLength(63)
param fabricCapacityName string = 'frti${uniqueString(resourceGroup().id)}'

@description('Capacity SKU. F2 is the smallest starting point, not a throughput guarantee.')
@allowed(['F2', 'F4', 'F8', 'F16', 'F32', 'F64'])
param fabricCapacitySku string = 'F2'

@description('Capacity administrator identities accepted by Fabric, for example user UPNs. Required when creating a capacity.')
param fabricCapacityAdministrators array = []

@description('Opt in to a billable Azure Managed Grafana Standard instance.')
param deployManagedGrafana bool = false

@description('Opt in to cloud collector hosting, a manual synthetic telemetry job and platform diagnostics. Enable after Fabric setup and managed identity grants.')
param deployCollector bool = false

@description('Fabric KQL QUERY service URI, required when deployCollector is true. Do not use the ingest URI.')
param kustoClusterUri string = ''

@description('Fabric KQL database display name.')
param kustoDatabase string = 'Observability'

@description('Collector image with a reviewed Azure Data Explorer exporter version. Pin a digest for controlled deployments.')
param collectorImage string = 'otel/opentelemetry-collector-contrib:0.141.0'

@description('Python runtime for the bounded synthetic emitter. Pin a digest for controlled deployments.')
param emitterImage string = 'python:3.13-slim'

@description('Managed Grafana resource name.')
@minLength(2)
@maxLength(30)
param grafanaName string = 'frti-${uniqueString(resourceGroup().id)}'

@description('Object ID of the user, group, or service principal to receive Grafana Admin on this resource only.')
param grafanaAdminPrincipalId string = ''

@allowed(['User', 'Group', 'ServicePrincipal'])
param grafanaAdminPrincipalType string = 'User'

@description('Tags applied to resources.')
param tags object = {
  project: 'fabric-rti-monitoring'
  purpose: 'observability-demo'
  'managed-by': 'bicep'
}

// Fabric workspace, Eventhouse and KQL database use Fabric REST APIs, not ARM.
// Bootstrap them separately with scripts/bootstrap-fabric.py.
resource capacity 'Microsoft.Fabric/capacities@2023-11-01' = if (deployFabricCapacity) {
  name: fabricCapacityName
  location: location
  tags: tags
  sku: {
    name: fabricCapacitySku
    tier: 'Fabric'
  }
  properties: {
    administration: {
      members: fabricCapacityAdministrators
    }
  }
}

// Azure Data Explorer is included in Managed Grafana Standard's core plugins.
// No Marketplace Enterprise add-on is enabled by this template.
resource grafana 'Microsoft.Dashboard/grafana@2025-08-01' = if (deployManagedGrafana) {
  name: grafanaName
  location: location
  tags: tags
  sku: {
    name: 'Standard'
    size: 'X1'
  }
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    apiKey: 'Disabled'
    creatorCanAdmin: 'Disabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    publicNetworkAccess: 'Enabled'
    deterministicOutboundIP: 'Disabled'
    zoneRedundancy: 'Disabled'
  }
}

var grafanaAdminRoleDefinitionId = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '22926164-76b3-42b3-bc55-97df8dab3e41')

resource grafanaAdmin 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (deployManagedGrafana && !empty(grafanaAdminPrincipalId)) {
  name: guid(grafana.id, grafanaAdminPrincipalId, grafanaAdminRoleDefinitionId)
  scope: grafana
  properties: {
    roleDefinitionId: grafanaAdminRoleDefinitionId
    principalId: grafanaAdminPrincipalId
    principalType: grafanaAdminPrincipalType
  }
}

// Create the identity first so the database administrator can grant ingestor
// access before the collector starts. A user-assigned identity is not billed.
resource collectorIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'frti-collector-${uniqueString(resourceGroup().id)}'
  location: location
  tags: tags
}

module collector './modules/collector.bicep' = if (deployCollector) {
  name: 'collector-runtime'
  params: {
    location: location
    tags: tags
    nameSuffix: uniqueString(resourceGroup().id)
    collectorIdentityId: collectorIdentity.id
    collectorIdentityClientId: collectorIdentity.properties.clientId
    kustoClusterUri: kustoClusterUri
    kustoDatabase: kustoDatabase
    collectorImage: collectorImage
    emitterImage: emitterImage
  }
}

@description('ARM resource ID. This is NOT the Fabric capacity UUID needed by the bootstrap script.')
output fabricCapacityArmId string = deployFabricCapacity ? capacity!.id : ''
output fabricCapacityResourceName string = deployFabricCapacity ? capacity!.name : ''
output grafanaResourceName string = deployManagedGrafana ? grafana!.name : ''
output grafanaEndpoint string = deployManagedGrafana ? grafana!.properties.endpoint : ''
output grafanaPrincipalId string = deployManagedGrafana ? grafana!.identity.principalId : ''
output collectorIdentityClientId string = collectorIdentity.properties.clientId
output collectorIdentityPrincipalId string = collectorIdentity.properties.principalId
output tenantId string = tenant().tenantId
output collectorAppName string = deployCollector ? collector!.outputs.collectorAppName : ''
output collectorInternalEndpoint string = deployCollector ? collector!.outputs.collectorInternalEndpoint : ''
output demoJobName string = deployCollector ? collector!.outputs.demoJobName : ''
output platformLogAnalyticsWorkspaceId string = deployCollector ? collector!.outputs.platformLogAnalyticsWorkspaceId : ''
